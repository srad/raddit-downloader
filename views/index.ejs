<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Raddit Downloader</title>
    <link rel="stylesheet" href="style.css">
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <script src="/socket.io/socket.io.js"></script>
</head>
<body>

<!-- Header -->
<div class="header">
    <div class="header-top">
        <div class="logo">
            <span>Raddit Downloader</span>
            <span class="logo-version">v<%= version %></span>
        </div>
        <div class="header-actions">
            <button class="btn btn-secondary" onclick="toggleLogs()">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"
                     style="vertical-align: -2px; margin-right: 6px;">
                    <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                    <path d="M3 4.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zm0 2a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zm0 2a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5z"/>
                </svg>
                Logs
            </button>
        </div>
    </div>

    <form id="downloadForm" class="search-container" hx-post="/api/start" hx-swap="none">
        <div class="main-input-group">
            <input id="searchInput" list="history" name="subreddit" placeholder="Enter subreddit or u/username..." required
                   autocomplete="off">
            <datalist id="history"></datalist>
            <button type="submit" class="btn" id="startBtn">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16"
                     style="vertical-align: -3px; margin-right: 6px;">
                    <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                    <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/>
                </svg>
                Download
            </button>
            <button type="button" class="btn btn-stop" id="stopBtn" hx-post="/api/stop" disabled style="display: none;">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"
                     style="vertical-align: -2px; margin-right: 6px;">
                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                    <path fill-rule="evenodd"
                          d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                </svg>
                Stop
            </button>
        </div>

        <div class="options-toggle" onclick="toggleOptions()">
            <svg fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd"
                      d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
            </svg>
            <span>Advanced Options</span>
        </div>

        <div class="options-row" id="advancedOptions">
            <div class="input-group">
                <label class="input-label">Sort By</label>
                <select name="sorting">
                    <option value="top">Top</option>
                    <option value="hot">Hot</option>
                    <option value="new" selected>New</option>
                    <option value="rising">Rising</option>
                </select>
            </div>

            <div class="input-group">
                <label class="input-label">Time Period</label>
                <select name="time">
                    <option value="all" selected>All Time</option>
                    <option value="month">This Month</option>
                    <option value="year">This Year</option>
                    <option value="week">This Week</option>
                    <option value="day">Today</option>
                </select>
            </div>

            <div class="input-group">
                <label class="input-label">Post Limit</label>
                <div class="input-wrapper">
                    <input type="number" name="limit" value="0" min="0" placeholder="50">
                    <div class="input-hint">0 for unlimited</div>
                </div>
            </div>
        </div>

        <div id="progressContainer" class="progress-bar-container" style="display: none;">
            <div id="progressFill" class="progress-bar-fill" style="width: 0%;"></div>
            <span id="progressText" class="progress-text">0 / 0 posts (0%)</span>
        </div>
    </form>
</div>

<!-- Main App -->
<div class="app-container">
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">FILES</div>
        <div id="file-tree" class="file-tree">
            <div style="padding:10px; color:#666;">Loading files...</div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="gallery-toolbar">
            <div style="display: flex; align-items: center; gap: 15px; flex: 1;">
                <div id="current-path" style="font-weight: bold; min-width: 50px;">/</div>
                <div style="display: flex; gap: 8px; flex: 1; max-width: 400px;">
                    <input type="text" id="filter-text" placeholder="Filter files..."
                           oninput="applyFilter()"
                           style="padding: 4px 8px; font-size: 0.85rem; height: 30px;">
                    <select id="filter-type" onchange="applyFilter()"
                            style="width: auto; padding: 4px 8px; font-size: 0.85rem; height: 30px;">
                        <option value="all">All Types</option>
                        <option value="image">Images</option>
                        <option value="video">Videos</option>
                    </select>
                </div>
            </div>
            <div style="display: flex; gap: 10px; align-items: center;">
                <span id="selection-count"
                      style="display:none; color: var(--primary);">0 selected</span>
                <button class="btn btn-danger" id="deleteBtn"
                        style="display:none; padding: 4px 10px; font-size: 0.8rem;" onclick="deleteSelected()">Delete
                </button>
            </div>
        </div>

        <div id="gallery-grid" class="gallery-grid">
            <!-- Gallery Items -->
            <div style="grid-column: 1/-1; text-align: center; color: #444; margin-top: 100px;">
                Select a folder from the sidebar to view images.
            </div>
        </div>

        <div id="logs-panel" class="logs-panel"></div>
    </div>
</div>

<!-- Lightbox -->
<div class="lightbox" id="lightbox">
    <span class="lightbox-close" onclick="closeLightbox()">×</span>
    <div class="lightbox-nav lightbox-prev" onclick="prevImage()">&#10094;</div>
    <div class="lightbox-nav lightbox-next" onclick="nextImage()">&#10095;</div>

    <div id="lightbox-container"
         style="display: flex; justify-content: center; align-items: center; width: 100%; height: 100%;"></div>

    <div id="lightbox-info" class="lightbox-info" style="display: none;"></div>
</div>

<script src="app.js" defer></script>
</body>
</html>